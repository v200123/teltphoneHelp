<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:orientation="horizontal"
        android:id="@+id/top_guide_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:layout_marginTop="@dimen/x128"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rl_img_login"
        android:visibility="visible"
        android:layout_width="@dimen/x90"
        android:layout_height="@dimen/x90"
        android:layout_marginTop="@dimen/x10"
        android:layout_marginStart="@dimen/x30"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_guide_line">
        <ImageView
            android:id="@+id/img_login"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/mine_login_icon"
            android:contentDescription="个人信息"/>
        <ImageView
            android:id="@+id/img_login_bg"
            android:background="@drawable/mine_login_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/star_user"
            android:layout_width="@dimen/x32"
            android:layout_height="@dimen/x32"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.example.myservicecenter.customView.CustomFontTextView
        android:textSize="@dimen/x48"
        android:textColor="@color/color_FF000000"
        android:id="@+id/tel_num_txt"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:importantForAccessibility="yes"
        android:layout_marginStart="@dimen/x18"
        android:letterSpacing="-0.05"
        app:layout_constraintLeft_toRightOf="@+id/rl_img_login"
        app:layout_constraintTop_toTopOf="@+id/top_guide_line"/>
    <RelativeLayout
        android:id="@+id/rl_change_login"
        android:background="@drawable/shape_corner_17_33000000"
        android:layout_width="@dimen/x48"
        android:layout_height="@dimen/x34"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/x12"
        app:layout_constraintBottom_toBottomOf="@+id/tel_num_txt"
        app:layout_constraintLeft_toRightOf="@+id/tel_num_txt"
        app:layout_constraintTop_toTopOf="@+id/tel_num_txt">
        <ImageView
            android:layout_width="@dimen/x22"
            android:layout_height="@dimen/x21"
            android:src="@drawable/mine_login_change_svg"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_birthday_gift"
        android:visibility="gone"
        android:layout_width="@dimen/x140"
        android:layout_height="@dimen/x50"
        android:layout_marginLeft="@dimen/x12"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/rl_change_login"
        app:layout_constraintLeft_toRightOf="@+id/rl_change_login"/>
    <TextView
        android:textSize="@dimen/x24"
        android:textColor="@color/color_FF000000"
        android:id="@+id/city_name_txt"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_below="@+id/tel_num_txt"
        android:importantForAccessibility="yes"
        android:layout_alignStart="@+id/tel_num_txt"
        app:layout_constraintBottom_toBottomOf="@+id/rl_img_login"
        app:layout_constraintLeft_toLeftOf="@+id/tel_num_txt"/>
    <ImageView
        android:id="@+id/member_img"
        android:layout_width="@dimen/x136"
        android:layout_height="@dimen/x30"
        android:layout_below="@+id/tel_num_txt"
        android:contentDescription="@null"
        android:layout_alignStart="@+id/tel_num_txt"
        app:layout_constraintLeft_toLeftOf="@+id/tel_num_txt"
        app:layout_constraintTop_toBottomOf="@+id/tel_num_txt"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_type"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x36"
        android:layout_marginTop="@dimen/x12"
        android:layout_below="@+id/tel_num_txt"
        android:layout_alignStart="@+id/tel_num_txt"
        app:layout_constraintLeft_toLeftOf="@+id/tel_num_txt"
        app:layout_constraintTop_toBottomOf="@+id/tel_num_txt">
        <RelativeLayout
            android:id="@+id/rl_brand"
            android:visibility="gone"
            android:layout_marginRight="@dimen/x12"
            style="@style/relativeLayout_global_normal">
            <ImageView
                android:id="@+id/brand_img"
                android:contentDescription="@null"
                style="@style/imageview_global_normal"/>
            <TextView
                android:id="@+id/tv_brand"
                style="@style/textview_global_normal"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_plus"
            android:visibility="gone"
            style="@style/relativeLayout_global_normal">
            <ImageView
                android:id="@+id/plus_img"
                style="@style/imageview_global_normal"/>
            <TextView
                android:id="@+id/tv_plus"
                style="@style/textview_global_normal"/>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/float_window_img_min"
        android:visibility="gone"
        android:layout_width="@dimen/x160"
        android:layout_height="@dimen/x50"
        android:layout_marginTop="@dimen/fx8"
        android:importantForAccessibility="no"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_guide_line"/>
    <ImageView
        android:id="@+id/float_window_img_bottom"
        android:visibility="gone"
        android:layout_width="@dimen/x160"
        android:layout_height="@dimen/x50"
        android:layout_marginTop="@dimen/x24"
        android:importantForAccessibility="no"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/float_window_img_min"/>
    <ImageView
        android:id="@+id/float_window_img"
        android:visibility="visible"
        android:layout_width="@dimen/x192"
        android:layout_height="@dimen/x130"
        android:layout_marginTop="@dimen/fx10"
        android:importantForAccessibility="no"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_guide_line"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_login_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x1"
        android:layout_marginTop="@dimen/x28"
        android:layout_marginRight="@dimen/x1"
        android:baselineAligned="false"
        android:layout_alignParentBottom="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
