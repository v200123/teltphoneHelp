<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filterContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="34dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/searchInputContainer"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvFilterMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/detail_module_gray_triangle"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text="@string/filter_call_out"
                android:textColor="@color/text_primary"
                android:textSize="12dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/vSearchDivider"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:background="@color/stroke_soft"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvFilterMode"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etSearchPhone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:hint="@string/filter_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="phone"
                android:maxLines="1"
                android:paddingStart="15dp"
                android:paddingEnd="0dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivClearSearch"
                app:layout_constraintStart_toEndOf="@id/vSearchDivider"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivClearSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_search_clear"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSearch"
                app:layout_constraintStart_toEndOf="@id/etSearchPhone"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="65dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_button"
                android:gravity="center"
                android:text="@string/filter_search"
                android:textColor="@android:color/white"
                android:textSize="12dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="22dp">

        <TextView
            android:id="@+id/tvFilterFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/detail_module_gray_triangle"
            android:drawablePadding="4dp"
            android:gravity="start|center_vertical"
            android:text="@string/filter_fee"
            android:textColor="@color/text_secondary"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvFilterMainCalled"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFilterMainCalled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:drawableEnd="@drawable/detail_module_gray_triangle"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/filter_main_called"
            android:textColor="@color/text_secondary"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvFilterLocation"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvFilterFee"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFilterLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:drawableEnd="@drawable/detail_module_gray_triangle"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/filter_location"
            android:textColor="@color/text_secondary"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvFilterType"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvFilterMainCalled"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFilterType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:drawableEnd="@drawable/detail_module_gray_triangle"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/filter_type"
            android:textColor="@color/text_secondary"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvFilterLocation"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_contact_name"
            android:textColor="@color/text_hint"
            android:textSize="12dp" />

        <View
            android:layout_width="30dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_switch_off" />
    </LinearLayout>
</LinearLayout>
