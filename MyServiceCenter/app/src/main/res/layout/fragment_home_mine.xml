<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="#F5F6F8"
    android:layout_height="match_parent">
    <ImageView
        android:contentDescription=""
        android:src="@drawable/mine_bg_user_origin"
        android:adjustViewBounds="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mineScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutMine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:background="@drawable/ic_home_mine_top"
                    android:gravity="center_vertical"
                    android:paddingEnd="16dp">


                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/rl_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:orientation="horizontal"
                        android:id="@+id/top_guide_line"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/x1"
                        android:layout_marginTop="@dimen/x21"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <RelativeLayout
                        android:id="@+id/rl_img_login"
                        android:visibility="visible"
                        android:layout_width="@dimen/x90"
                        android:layout_height="@dimen/x90"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_marginStart="@dimen/x30"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/top_guide_line">
                        <ImageView
                            android:id="@+id/img_login"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/mine_login_icon"
                            android:contentDescription="个人信息"/>
                        <ImageView
                            android:id="@+id/img_login_bg"
                            android:background="@drawable/mine_login_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:id="@+id/star_user"
                            android:layout_width="@dimen/x32"
                            android:layout_height="@dimen/x32"
                            android:layout_alignParentBottom="true"
                            android:contentDescription="@null"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <com.example.myservicecenter.customView.CustomFontTextView
                        android:textSize="@dimen/x48"
                        android:textColor="@color/color_FF000000"
                        android:id="@+id/tel_num_txt"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="yes"
                        android:layout_marginStart="@dimen/x18"
                        android:letterSpacing="-0.05"
                        app:layout_constraintLeft_toRightOf="@+id/rl_img_login"
                        app:layout_constraintTop_toTopOf="@+id/top_guide_line"/>
                    <RelativeLayout
                        android:id="@+id/rl_change_login"
                        android:background="@drawable/shape_corner_17_33000000"
                        android:layout_width="@dimen/x48"
                        android:layout_height="@dimen/x34"
                        android:contentDescription="@null"
                        android:layout_marginStart="@dimen/x12"
                        app:layout_constraintBottom_toBottomOf="@+id/tel_num_txt"
                        app:layout_constraintLeft_toRightOf="@+id/tel_num_txt"
                        app:layout_constraintTop_toTopOf="@+id/tel_num_txt">
                        <ImageView
                            android:layout_width="@dimen/x22"
                            android:layout_height="@dimen/x21"
                            android:src="@drawable/mine_login_change_svg"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/iv_birthday_gift"
                        android:visibility="gone"
                        android:layout_width="@dimen/x140"
                        android:layout_height="@dimen/x50"
                        android:layout_marginLeft="@dimen/x12"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="@+id/rl_change_login"
                        app:layout_constraintLeft_toRightOf="@+id/rl_change_login"/>
                    <TextView
                        android:textSize="@dimen/x24"
                        android:textColor="@color/color_FF000000"
                        android:id="@+id/city_name_txt"
                        android:focusable="true"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_below="@+id/tel_num_txt"
                        android:importantForAccessibility="yes"
                        android:layout_alignStart="@+id/tel_num_txt"
                        app:layout_constraintBottom_toBottomOf="@+id/rl_img_login"
                        app:layout_constraintLeft_toLeftOf="@+id/tel_num_txt"/>
                    <ImageView
                        android:id="@+id/member_img"
                        android:layout_width="@dimen/x136"
                        android:layout_height="@dimen/x30"
                        android:layout_below="@+id/tel_num_txt"
                        android:contentDescription="@null"
                        android:layout_alignStart="@+id/tel_num_txt"
                        app:layout_constraintLeft_toLeftOf="@+id/tel_num_txt"
                        app:layout_constraintTop_toBottomOf="@+id/tel_num_txt"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_type"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/x36"
                        android:layout_marginTop="@dimen/x12"
                        android:layout_below="@+id/tel_num_txt"
                        android:layout_alignStart="@+id/tel_num_txt"
                        app:layout_constraintLeft_toLeftOf="@+id/tel_num_txt"
                        app:layout_constraintTop_toBottomOf="@+id/tel_num_txt">
                        <RelativeLayout
                            android:id="@+id/rl_brand"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/x12"
                            style="@style/relativeLayout_global_normal">
                            <ImageView
                                android:id="@+id/brand_img"
                                android:contentDescription="@null"
                                style="@style/imageview_global_normal"/>
                            <TextView
                                android:id="@+id/tv_brand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/textview_global_normal"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rl_plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            style="@style/relativeLayout_global_normal">
                            <ImageView
                                android:id="@+id/plus_img"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/imageview_global_normal"/>
                            <TextView
                                android:id="@+id/tv_plus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/textview_global_normal"/>
                        </RelativeLayout>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/float_window_img_min"
                        android:visibility="gone"
                        android:layout_width="@dimen/x160"
                        android:layout_height="@dimen/x50"
                        android:layout_marginTop="@dimen/fx8"
                        android:importantForAccessibility="no"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/top_guide_line"/>
                    <ImageView
                        android:id="@+id/float_window_img_bottom"
                        android:visibility="gone"
                        android:layout_width="@dimen/x160"
                        android:layout_height="@dimen/x50"
                        android:layout_marginTop="@dimen/x24"
                        android:importantForAccessibility="no"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/float_window_img_min"/>
                    <ImageView
                        android:id="@+id/float_window_img"
                        android:visibility="visible"
                        android:layout_width="@dimen/x192"
                        android:layout_height="@dimen/x130"
                        android:layout_marginTop="@dimen/fx10"
                        android:importantForAccessibility="no"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/top_guide_line"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_login_card"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/x1"
                        android:layout_marginTop="@dimen/x28"
                        android:layout_marginRight="@dimen/x1"
                        android:baselineAligned="false"
                        android:layout_alignParentBottom="true"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ll_type"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rl_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="6dp">

                <com.example.myservicecenter.customView.BaseCodeView
                    android:id="@+id/base_code_01"
                    android:layout_width="0px"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
                <com.example.myservicecenter.customView.BaseCodeView
                    android:id="@+id/base_code_02"
                    android:layout_width="0px"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
                <com.example.myservicecenter.customView.BaseCodeView
                    android:id="@+id/base_code_03"
                    android:layout_width="0px"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
                <com.example.myservicecenter.customView.BaseCodeView
                    android:id="@+id/base_code_04"
                    android:layout_width="0px"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_mine_mine_equity"
                android:layout_width="match_parent"
                android:layout_height="67dp"
                android:layout_marginStart="@dimen/x30"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/ic_home_mine_quanyi"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"></FrameLayout>

            <LinearLayout
                android:id="@+id/ll_mine_combo"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginStart="@dimen/x30"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/ic_home_mine_01"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llMineComboContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_white_rounded"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_service_title"
                        android:textColor="#161E2A"
                        android:textSize="17dp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_mine_service_center"
                        android:layout_width="wrap_content"
                        android:layout_height="23dp"
                        android:adjustViewBounds="true" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/hsvMineServiceCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <GridLayout
                        android:id="@+id/gl_mine_service_center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:rowCount="2" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center">

                    <FrameLayout
                        android:id="@+id/flMineServiceCenterIndicator"
                        android:layout_width="28dp"
                        android:layout_height="4dp">

                        <View
                            android:id="@+id/viewMineServiceCenterIndicatorTrack"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#D8E1EB" />

                        <View
                            android:id="@+id/viewMineServiceCenterIndicatorThumb"
                            android:layout_width="16dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_blue_pill" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_white_rounded"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_device_title"
                        android:textColor="#161E2A"
                        android:textSize="22dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_device_more"
                        android:textColor="#A0A7B3"
                        android:textSize="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_phone_dark"
                            android:gravity="center"
                            android:text="@string/home_device_badge_gt"
                            android:textColor="#FFFFFF"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_name_gt"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_trade"
                            android:gravity="center"
                            android:text="@string/home_device_badge_trade"
                            android:textColor="#FFFFFF"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_price_trade"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_phone_orange"
                            android:gravity="center"
                            android:text="@string/home_device_badge_phone"
                            android:textColor="#FFFFFF"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_price_phone_a"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_phone_light"
                            android:gravity="center"
                            android:text="@string/home_device_badge_phone"
                            android:textColor="#7E5FB8"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_price_phone_b"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

