                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_device_title"
                        android:textColor="#161E2A"
                        android:textSize="22dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_device_more"
                        android:textColor="#A0A7B3"
                        android:textSize="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_phone_dark"
                            android:gravity="center"
                            android:text="@string/home_device_badge_gt"
                            android:textColor="#FFFFFF"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_name_gt"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_trade"
                            android:gravity="center"
                            android:text="@string/home_device_badge_trade"
                            android:textColor="#FFFFFF"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_price_trade"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_phone_orange"
                            android:gravity="center"
                            android:text="@string/home_device_badge_phone"
                            android:textColor="#FFFFFF"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_price_phone_a"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_device_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_home_device_phone_light"
                            android:gravity="center"
                            android:text="@string/home_device_badge_phone"
                            android:textColor="#7E5FB8"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_device_price_phone_b"
                            android:textColor="#232B37"
                            android:textSize="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

