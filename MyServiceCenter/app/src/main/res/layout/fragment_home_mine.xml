                        android:id="@+id/iv_mine_service_center"
                        android:layout_width="wrap_content"
                        android:layout_height="23dp"
                        android:adjustViewBounds="true" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/hsvMineServiceCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <GridLayout
                        android:id="@+id/gl_mine_service_center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:rowCount="2" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center">

                    <FrameLayout
                        android:id="@+id/flMineServiceCenterIndicator"
                        android:layout_width="28dp"
                        android:layout_height="4dp">

                        <View
                            android:id="@+id/viewMineServiceCenterIndicatorTrack"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#D8E1EB" />

                        <View
                            android:id="@+id/viewMineServiceCenterIndicatorThumb"
                            android:layout_width="16dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_blue_pill" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
