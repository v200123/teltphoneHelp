<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_reference_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="false"
    android:overScrollMode="never"
    android:paddingBottom="92dp">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="28dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topNavRow"
            android:layout_width="match_parent"
            android:layout_height="70dp">

            <HorizontalScrollView
                android:id="@+id/homeTabsScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:fadingEdge="horizontal"
                android:overScrollMode="never"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/homeAdBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/homeTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:text="@string/home_nav_recommend"
                        android:textColor="#008CFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HomeReferenceNavText"
                        android:text="@string/home_nav_family" />

                    <TextView
                        style="@style/HomeReferenceNavText"
                        android:text="@string/home_nav_senior" />

                    <TextView
                        style="@style/HomeReferenceNavText"
                        android:text="@string/home_nav_nearby" />

                    <TextView
                        style="@style/HomeReferenceNavText"
                        android:alpha="0.35"
                        android:text="@string/home_nav_ai" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/homeAdBanner"
                android:layout_width="150dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_home_reference_ad"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/home_reference_ad_text"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_search"
            android:paddingStart="15dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home_reference_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#5F6771" />

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical"
                android:text="@string/home_reference_search_hint"
                android:textColor="#3B424B"
                android:textSize="22sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivScan"
                app:layout_constraintStart_toEndOf="@id/ivSearch"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivScan"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="18dp"
                android:contentDescription="@string/home_reference_scan"
                android:src="@drawable/ic_home_reference_scan"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/searchDivider"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#5F6771" />

            <View
                android:id="@+id/searchDivider"
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="#D7DCE3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvSearchAction"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSearchAction"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/home_reference_search"
                android:textColor="#0787F6"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/greetingRow"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/tvHomeGreeting"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#252A31"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/actionRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="下午好， 136****0135 ⇄" />

            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="104dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_home_reference_action"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_home_reference_gift" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/home_reference_sign_gift"
                        android:textColor="#252A31"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_home_reference_action">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/home_reference_message"
                        android:textColor="#252A31"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-5dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_home_reference_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="2"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/home_reference_more"
                    android:textColor="#252A31"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/balanceCard"
            android:layout_width="match_parent"
            android:layout_height="292dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_home_summary_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/ivMobileLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_cmcc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/mobileBrandText"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@id/ivMobileLogo"
                app:layout_constraintTop_toTopOf="@id/ivMobileLogo">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_reference_china_mobile"
                    android:textColor="#0D95CE"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="China Mobile"
                    android:textColor="#0D95CE"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/checkButton"
                android:layout_width="102dp"
                android:layout_height="58dp"
                android:layout_marginTop="-3dp"
                android:layout_marginEnd="-18dp"
                android:background="@drawable/bg_home_reference_check"
                android:gravity="center"
                android:text="@string/home_reference_one_key_check"
                android:textColor="#262B32"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/statRow"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/downChevron"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivMobileLogo">

                <LinearLayout
                    style="@style/HomeReferenceStatItem"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tvDataValue"
                        style="@style/HomeReferenceStatValue"
                        android:text="--" />

                    <TextView
                        style="@style/HomeReferenceStatLabel"
                        android:text="@string/home_stat_data_rest" />

                    <TextView
                        style="@style/HomeReferenceStatButton"
                        android:text="@string/home_reference_charge_data" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeReferenceStatItem"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center|bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBalanceValue"
                            style="@style/HomeReferenceStatValue"
                            android:layout_width="wrap_content"
                            android:text="338.27" />

                        <TextView
                            style="@style/HomeReferenceStatUnit"
                            android:text="@string/home_reference_yuan" />
                    </LinearLayout>

                    <TextView
                        style="@style/HomeReferenceStatLabel"
                        android:text="@string/home_stat_balance_rest" />

                    <TextView
                        style="@style/HomeReferenceStatButton"
                        android:text="@string/home_reference_charge_fee" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeReferenceStatItem"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center|bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCallValue"
                            style="@style/HomeReferenceStatValue"
                            android:layout_width="wrap_content"
                            android:text="30" />

                        <TextView
                            style="@style/HomeReferenceStatUnit"
                            android:text="@string/home_reference_minutes" />
                    </LinearLayout>

                    <TextView
                        style="@style/HomeReferenceStatLabel"
                        android:text="@string/home_stat_call_rest" />

                    <TextView
                        style="@style/HomeReferenceStatButton"
                        android:text="@string/home_reference_package" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeReferenceStatItem"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center|bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBeanValue"
                            style="@style/HomeReferenceStatValue"
                            android:layout_width="wrap_content"
                            android:text="170" />

                        <TextView
                            style="@style/HomeReferenceStatUnit"
                            android:text="@string/home_reference_bean" />
                    </LinearLayout>

                    <TextView
                        style="@style/HomeReferenceStatLabel"
                        android:text="@string/home_stat_ai_bean" />

                    <TextView
                        style="@style/HomeReferenceStatButton"
                        android:text="@string/home_reference_use" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/downChevron"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:alpha="0.42"
                android:gravity="center"
                android:text="⌄⌄"
                android:textColor="#5FA9DE"
                android:textSize="42sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
