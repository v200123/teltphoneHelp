<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.myservicecenter.customView.HomeTopTabItemView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabSelected="true"
            app:tabText="推荐" />

        <com.example.myservicecenter.customView.HomeTopTabItemView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabSelected="false"
            app:tabText="爱家" />

        <com.example.myservicecenter.customView.HomeTopTabItemView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabSelected="false"

            app:tabText="网龄" />

        <com.example.myservicecenter.customView.HomeTopTabItemView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabSelected="false"
            app:tabText="附近厅" />

        <com.example.myservicecenter.customView.HomeTopTabItemView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabSelected="false"
            app:tabText="AI尝鲜" />


    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="@dimen/x8"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/search_view_cl"
        android:background="@drawable/bg_top_view_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x72"
        android:layout_marginStart="@dimen/x24"
        android:layout_marginEnd="@dimen/x24"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">
        <ImageView
            android:id="@+id/search_view_icon"
            android:layout_width="@dimen/x34"
            android:layout_height="@dimen/x34"
            android:src="@mipmap/icon_app_top_view_search"
            android:layout_marginStart="@dimen/x21"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/search_view_vlt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/x10"
            android:layout_marginEnd="@dimen/x10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/search_view_icon"
            app:layout_constraintRight_toLeftOf="@+id/search_view_operation"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/search_view_operation"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/search_view_scan"
                android:visibility="gone"
                android:layout_width="@dimen/x39"
                android:layout_height="@dimen/x39"
                android:layout_marginEnd="@dimen/x24"/>
            <View
                android:id="@+id/search_view_split"
                android:background="#cdcdcd"

                android:layout_width="@dimen/dp_1"
                android:layout_height="@dimen/x28"
                android:layout_marginEnd="@dimen/x24"/>
            <TextView
                android:textSize="@dimen/x28"
                android:textColor="#007eff"
                android:id="@+id/search_view_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:layout_marginEnd="@dimen/x28"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cl_top_info"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x66"
        android:paddingStart="@dimen/x18">
        <FrameLayout
            android:gravity="center_vertical"
            android:id="@+id/top_info_left_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/x100"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/view_title_account_container"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x66">
                <TextView
                    android:textSize="@dimen/x26"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_info_greetings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/x6"/>
                <com.example.myservicecenter.customView.CustomFontTextView
                    android:textSize="@dimen/x32"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_info_account"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"/>
                <ImageView
                    android:id="@+id/iv_info_switch"
                    android:layout_width="@dimen/x34"
                    android:layout_height="@dimen/x34"
                    android:src="@drawable/icon_home2_0_top_info_account_switch"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:id="@+id/top_info_right_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/x100"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/rl_container_top_info_right_other_btn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x66"
                android:layout_marginStart="@dimen/x6">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/home2_0_top_info_right_item_cl"
                    android:background="@drawable/bg_white_r12"
                    android:paddingLeft="@dimen/x2"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/x56"
                    android:layout_marginTop="@dimen/x5"
                    android:minWidth="@dimen/x96"
                    android:layout_marginEnd="@dimen/x6"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="@+id/home2_0_top_info_right_tv_unread"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/home2_0_top_info_right_item_left_img"
                        android:visibility="visible"
                        android:layout_width="@dimen/x50"
                        android:layout_height="@dimen/x50"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/x26"
                        android:textColor="@color/color_333333"
                        android:id="@+id/home2_0_top_info_right_item_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:customFontWeight="1.3"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/home2_0_top_info_right_item_left_img"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:layout_gravity="top"
                        android:id="@+id/home2_0_top_info_right_iv_unread"
                        android:visibility="gone"
                        android:layout_width="@dimen/x12"
                        android:layout_height="@dimen/x12"
                        android:layout_marginTop="@dimen/x8"
                        android:src="@drawable/mine_red_point"
                        app:layout_constraintBottom_toTopOf="@+id/home2_0_top_info_right_item_text"
                        app:layout_constraintLeft_toRightOf="@+id/home2_0_top_info_right_item_text"
                        app:layout_constraintRight_toRightOf="@+id/home2_0_top_info_right_item_text"
                        app:layout_constraintTop_toTopOf="@+id/home2_0_top_info_right_item_text"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/x18"
                    android:textColor="@color/color_FFFFFF"
                    android:gravity="center"
                    android:id="@+id/home2_0_top_info_right_tv_unread"
                    android:background="@drawable/home2_0_top_info_right_msg_3"
                    android:visibility="gone"
                    android:layout_width="@dimen/x28"
                    android:layout_height="@dimen/x26"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <ImageView
        android:id="@+id/iv_show_top_gif"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x90"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
