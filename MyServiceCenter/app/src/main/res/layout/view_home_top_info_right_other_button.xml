<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home2_0_top_info_right_item_cl"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x56"
        android:layout_marginTop="@dimen/x5"
        android:layout_marginEnd="@dimen/x6"
        android:background="@drawable/bg_white_r12"
        android:minWidth="@dimen/x96"
        android:paddingLeft="@dimen/x2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/home2_0_top_info_right_tv_unread"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/home2_0_top_info_right_item_left_img"
            android:layout_width="@dimen/x50"
            android:layout_height="@dimen/x50"
            android:layout_gravity="center_vertical"
            android:scaleType="centerCrop"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/home2_0_top_info_right_item_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_333333"
            android:textStyle="bold"
            android:textSize="@dimen/x26"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/home2_0_top_info_right_item_left_img"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/home2_0_top_info_right_iv_unread"
            android:layout_width="@dimen/x12"
            android:layout_height="@dimen/x12"
            android:layout_gravity="top"
            android:layout_marginTop="@dimen/x8"
            android:src="@drawable/mine_red_point"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/home2_0_top_info_right_item_text"
            app:layout_constraintLeft_toRightOf="@+id/home2_0_top_info_right_item_text"
            app:layout_constraintRight_toRightOf="@+id/home2_0_top_info_right_item_text"
            app:layout_constraintTop_toTopOf="@+id/home2_0_top_info_right_item_text" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/home2_0_top_info_right_tv_unread"
        android:layout_width="@dimen/x28"
        android:layout_height="@dimen/x26"
        android:background="@drawable/home2_0_top_info_right_msg_3"
        android:gravity="center"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/x18"
        android:visibility="gone"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</merge>
