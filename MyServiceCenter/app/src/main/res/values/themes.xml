<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyServiceCenter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="TextAppearance.MyServiceCenter.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="HomeGridItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#212733</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HomeReferenceNavText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">26dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#2C3239</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeReferenceStatItem">
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HomeReferenceStatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:fontFamily">@font/dincondensed_bold</item>
        <item name="android:gravity">center|bottom</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#222832</item>
        <item name="android:textSize">36sp</item>
    </style>

    <style name="HomeReferenceStatUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#222832</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="HomeReferenceStatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#5F6670</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="HomeReferenceStatButton">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_home_reference_stat_button</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
